{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/cafe",
    "padding": {
      "top": 1
    }
  },
  "logo": "arch",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    {
      "type": "terminal",
      "format": "{5}"
    },
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    "colors"
  ]
}
